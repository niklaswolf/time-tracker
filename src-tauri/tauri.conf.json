{
  "$schema": "../node_modules/@tauri-apps/cli/schema.json",
  "build": {
    "beforeBuildCommand": "npm run generate",
    "beforeDevCommand": "npm run dev",
    "frontendDist": "../.output/public",
    "devUrl": "http://localhost:3000"
  },
  "bundle": {
    "active": true,
    "category": "DeveloperTool",
    "copyright": "",
    "targets": "all",
    "externalBin": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    },
    "longDescription": "",
    "macOS": {
      "entitlements": null,
      "exceptionDomain": "",
      "frameworks": [],
      "providerShortName": null,
      "signingIdentity": null
    },
    "resources": [],
    "shortDescription": "",
    "linux": {
      "deb": {
        "depends": []
      }
    }
  },
  "productName": "Time tracker",
  "mainBinaryName": "Time tracker",
  "version": "0.1.0",
  "identifier": "niklaswolf.timetracker",
  "plugins": {},
  "app": {
    "windows": [
      {
        "label": "menubar",
        "fullscreen": false,
        "height": 110,
        "resizable": false,
        "title": "menubar",
        "width": 300,
        "visible": false,
        "hiddenTitle": true,
        "decorations": false,
        "focus": false,
        "transparent": true,
        "useHttpsScheme": true
      },
      {
        "label": "main",
        "fullscreen": false,
        "height": 600,
        "resizable": true,
        "title": "main",
        "width": 800,
        "visible": true,
        "hiddenTitle": true,
        "decorations": true,
        "focus": false,
        "transparent": false,
        "useHttpsScheme": true
      },
      {
        "label": "idle-notification",
        "fullscreen": false,
        "height": 300,
        "resizable": false,
        "title": "idle-notification",
        "width": 600,
        "visible": false,
        "hiddenTitle": true,
        "decorations": false,
        "focus": false,
        "transparent": false,
        "useHttpsScheme": true
      }
    ],
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true
    },
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  }
}
